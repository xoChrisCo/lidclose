#!/usr/bin/env bash
# lidclose-watcher — chime when the lid closes while sleep is disabled,
# so you don't forget the Mac is staying awake in your bag.
#
# Run by the com.lidclose.watcher LaunchAgent. Polls every POLL_SECONDS.
# Config is re-read every loop, so edits to ~/.config/lidclose/config
# take effect without restarting the agent.
set -u

CONFIG="$HOME/.config/lidclose/config"
POLL_SECONDS=5

lid_closed() {
  ioreg -r -k AppleClamshellState -d 1 | grep -q '"AppleClamshellState" = Yes'
}

sleep_disabled() {
  pmset -g | grep -q 'SleepDisabled[[:space:]]*1'
}

chime() {
  # A closed lid muffles the speakers badly, so: enforce a minimum system
  # volume (restored afterwards), amplify with afplay -v, and space the
  # plays out so it's noticeable to someone already walking away.
  local vol muted
  vol=$(osascript -e 'output volume of (get volume settings)' 2>/dev/null || echo "")
  muted=$(osascript -e 'output muted of (get volume settings)' 2>/dev/null || echo "")
  if [ -n "$vol" ] && { [ "$muted" = "true" ] || [ "$vol" -lt "$MIN_VOLUME" ]; }; then
    osascript -e "set volume output volume $MIN_VOLUME"
  fi

  local i=0
  while [ "$i" -lt "$CHIME_REPEATS" ]; do
    afplay -v "$CHIME_GAIN" "$CHIME_SOUND"
    i=$((i + 1))
    [ "$i" -lt "$CHIME_REPEATS" ] && sleep 1
  done

  if [ -n "$vol" ]; then
    osascript -e "set volume output volume $vol"
    [ "$muted" = "true" ] && osascript -e 'set volume output muted true'
  fi
  return 0
}

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*"
}

log "watcher started (poll ${POLL_SECONDS}s)"

was_alerting=0
last_chime=0
while true; do
  # Defaults; config file overrides.
  CHIME_SOUND=/System/Library/Sounds/Glass.aiff
  CHIME_REPEATS=3   # plays per alert, 1s apart
  CHIME_GAIN=3      # afplay -v multiplier (>1 amplifies)
  MIN_VOLUME=60     # floor for system output volume during the alert
  REPEAT_MINUTES=0
  [ -f "$CONFIG" ] && . "$CONFIG"

  if lid_closed && sleep_disabled; then
    now=$(date +%s)
    if [ "$was_alerting" -eq 0 ]; then
      log "lid closed with sleep disabled — chiming"
      chime
      last_chime=$now
      was_alerting=1
    elif [ "${REPEAT_MINUTES:-0}" -gt 0 ] && [ $((now - last_chime)) -ge $((REPEAT_MINUTES * 60)) ]; then
      log "reminder chime (every ${REPEAT_MINUTES}m)"
      chime
      last_chime=$now
    fi
  else
    was_alerting=0
  fi

  sleep "$POLL_SECONDS"
done
