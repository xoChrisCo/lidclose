<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lidclose.watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>__DIR__/watcher/lidclose-watcher</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/lidclose-watcher.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/lidclose-watcher.log</string>
</dict>
</plist>
